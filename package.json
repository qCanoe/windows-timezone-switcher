{
  "name": "timezone-tray",
  "version": "1.0.0",
  "description": "Windows tray time zone switcher",
  "author": "Local Tools",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test electron/zones.test.cjs",
    "test:ui": "node check-ui.cjs",
    "package": "npm run build && electron-builder --win portable",
    "package:dir": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.0",
    "@fontsource/geist-mono": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.5.1",
    "electron-builder": "^26.0.0",
    "shadcn": "latest",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "local.timezone.tray",
    "productName": "Timezone Tray",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signExecutable": false,
      "icon": "electron/tray.ico"
    },
    "portable": {
      "artifactName": "TimezoneTray.exe"
    }
  }
}
